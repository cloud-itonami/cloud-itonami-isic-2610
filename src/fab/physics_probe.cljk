(ns fab.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL
  `fab.simphysics` wire-bond destructive pull test (MIL-STD-883 Method
  2011-style, on `physics-2d/world-step`) over a fixed sweep and print ONE
  EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2610/SOUL.md)
  reads every tick. Every number below is derived from a time-stepped
  trajectory by `fab.robotics/bond-pull-telemetry-for`, never typed in.
  Output schema `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo :procedure :solver
     :runs     [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived  {...}   ; quantities computed ACROSS runs
     :count n :expected n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [fab.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def band
  "The [min max] gf bond-pull band every `fab.store` seed lot carries."
  {:bond-pull-strength-min 6.0 :bond-pull-strength-max 12.0})

(def sweep-wire-diameters-um
  "Every bond-wire diameter the `fab.store` seed lots carry (15 / 24 / 25 /
  25.5 / 26.5 um) plus the 20 / 40 um the simphysics tests pin."
  [15.0 20.0 24.0 25.0 25.5 26.5 40.0])

(def sweep-specimen-dims-mm
  "The small / large test-specimen envelopes `simphysics-test` pins, at
  25 um. `fab.simphysics` discloses the reading as geometry-invariant;
  this sweep measures that claim every tick instead of trusting it."
  [{:specimen-length-mm 0.4 :specimen-width-mm 0.9}
   {:specimen-length-mm 1.6 :specimen-width-mm 3.6}])

(def geometry-sweep-diameter-um 25.0)

(defn- run-one [lot]
  (let [lot (merge band lot)
        t (robotics/bond-pull-telemetry-for lot)]
    {:input lot
     :quantities t
     :out-of-tolerance? (boolean (robotics/bond-pull-strength-out-of-range? (merge lot t)))}))

(defn- force-at [d-um]
  (:sim-bond-pull-force-gf (robotics/bond-pull-telemetry-for {:bond-wire-diameter-um d-um})))

(defn diameter-at-force-um
  "Wire diameter (um) at which the simulated pull force reaches
  `target-gf`, by bisection over the REAL simulation (force rises with
  diameter -- pinned by `simphysics-test`). nil when the bracket does not
  straddle the target."
  ([target-gf] (diameter-at-force-um target-gf 1.0 100.0 40))
  ([target-gf lo hi iters]
   (when (and (< (force-at lo) target-gf) (>= (force-at hi) target-gf))
     (loop [lo lo hi hi i 0]
       (if (>= i iters)
         hi
         (let [mid (/ (+ lo hi) 2.0)]
           (if (>= (force-at mid) target-gf)
             (recur lo mid (inc i))
             (recur mid hi (inc i)))))))))

(defn probe []
  (let [diam-runs (mapv #(run-one {:bond-wire-diameter-um %}) sweep-wire-diameters-um)
        geom-runs (mapv #(run-one (assoc % :bond-wire-diameter-um geometry-sweep-diameter-um))
                        sweep-specimen-dims-mm)
        runs (into diam-runs geom-runs)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-bond-pull-force-gf])))
        geom-forces (map #(get-in % [:quantities :sim-bond-pull-force-gf]) geom-runs)
        decels (map #(get-in % [:quantities :sim-peak-decel-mps2]) diam-runs)]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2610"
     :procedure "wire-bond destructive pull test (MIL-STD-883 Method 2011-style), robot process step"
     :solver "physics-2d/world-step via fab.simphysics/simulate"
     :runs runs
     :derived {:band-gf [(:bond-pull-strength-min band) (:bond-pull-strength-max band)]
               ;; the diameter window whose simulated force lands in the band
               :min-passing-diameter-um (diameter-at-force-um (:bond-pull-strength-min band))
               :max-passing-diameter-um (diameter-at-force-um (:bond-pull-strength-max band))
               ;; max - min across the diameter sweep: 0 means decel is mass-independent
               :decel-diameter-spread-mps2 (when (every? number? decels)
                                             (- (reduce max decels) (reduce min decels)))
               ;; max - min across the specimen-envelope sweep at 25 um
               :geometry-force-spread-gf (when (every? number? geom-forces)
                                           (- (reduce max geom-forces) (reduce min geom-forces)))}
     :count (count (filter numeric? runs))
     :expected (+ (count sweep-wire-diameters-um) (count sweep-specimen-dims-mm))}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
